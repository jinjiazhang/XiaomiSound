<view class="page {{loggedIn ? 'with-player' : ''}}">
  <view wx:if="{{!loggedIn}}" class="heading">把音乐送到家里</view>
  <view wx:if="{{!loggedIn}}" class="subtitle">连接小爱音箱，让喜欢的声音在家响起</view>

  <view wx:if="{{!loggedIn}}" class="card">
    <view class="card-title">{{otp ? '验证你的账号' : '登录小米账号'}}</view>
    <block wx:if="{{!otp}}">
      <view class="label">账号</view>
      <input class="input" value="{{account}}" data-field="account" bindinput="onInput" placeholder="手机号、邮箱或小米 ID" disabled="{{busy}}" />
      <view class="label">密码</view>
      <input class="input" password value="{{password}}" data-field="password" bindinput="onInput" placeholder="输入账号密码" disabled="{{busy}}" />
      <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="login">登录</button>
      <view class="hint">使用绑定音箱的账号。账号密码由云函数提交给小米，密码不保存；登录凭证保存在当前设备。</view>
    </block>
    <block wx:else>
      <view class="hint">请输入收到的{{otpMethod}}验证码</view>
      <input class="input code" value="{{code}}" data-field="code" bindinput="onInput" placeholder="验证码" disabled="{{busy}}" />
      <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="verify">验证并登录</button>
      <button class="text-button" disabled="{{busy}}" bindtap="cancelVerification">返回登录</button>
    </block>
  </view>

  <block wx:if="{{loggedIn}}">
    <view wx:if="{{tab === 'speaker'}}" class="card">
      <view class="card-head">
        <view class="card-title">已绑定 {{devices.length}} 台</view>
        <button size="mini" class="small-button" disabled="{{busy}}" bindtap="refreshDevices">刷新</button>
      </view>
      <picker wx:if="{{devices.length}}" mode="selector" range="{{devices}}" range-key="label" value="{{selectedIndex}}" bindchange="selectDevice" disabled="{{busy}}">
        <view class="device-picker">{{selectedDevice.label}} <text class="arrow">⌄</text></view>
      </picker>
      <view wx:else class="hint">没有找到音箱，请确认账号和设备网络后刷新。</view>
      <view wx:if="{{selectedDevice}}" class="hint">型号 {{selectedDevice.hardware}}</view>
    </view>
    <view wx:if="{{tab === 'speaker' && selectedDevice}}" class="card device-dashboard">
      <view class="speaker-illustration">♪</view>
      <view class="device-title">{{selectedDevice.name}}</view>
      <view class="status">{{selectedDevice.presence === 'online' ? statusText : '设备离线'}} · {{selectedDevice.hardware}}</view>
      <view wx:if="{{selectedDevice.presence !== 'online'}}" class="hint">请检查音箱电源和 Wi-Fi，再刷新设备列表。</view>
      <view class="feature-grid">
        <button class="feature" bindtap="openPlayer"><text class="feature-icon">♫</text>播放器</button>
        <button class="feature" bindtap="openVolume" disabled="{{busy || selectedDevice.presence !== 'online'}}"><text class="feature-icon">◖</text>音量调节</button>
        <button class="feature" data-tool="tts" bindtap="openTool" disabled="{{busy || selectedDevice.presence !== 'online'}}"><text class="feature-icon">☏</text>文字播报</button>
        <button class="feature" data-tool="timer" bindtap="openTool" disabled="{{busy || selectedDevice.presence !== 'online'}}"><text class="feature-icon">◷</text>睡眠定时</button>
        <button class="feature" data-tool="night" bindtap="openTool" disabled="{{busy || selectedDevice.presence !== 'online'}}"><text class="feature-icon">☾</text>夜间模式</button>
        <button class="feature" data-tool="info" bindtap="openTool"><text class="feature-icon">ⓘ</text>设备信息</button>
      </view>
    </view>
    <view wx:if="{{tab === 'music'}}" class="card music-card">
      <view class="music-icon">♫</view>
      <view class="track-title">{{audioTitle}}</view>
      <view class="track-caption">填写音频链接，发送到音箱播放</view>
      <input class="input" value="{{trackName}}" data-field="trackName" bindinput="onInput" placeholder="音频名称（可选）" maxlength="80" disabled="{{busy}}"/><view class="label audio-label">音频地址</view>
      <textarea wx:if="{{!playerOpen && !queueOpen && !toolOpen}}" class="input audio-url" value="{{audioUrl}}" data-field="audioUrl" bindinput="onInput" placeholder="https://example.com/audio.mp3" maxlength="-1" disabled="{{busy}}" />
      <button class="primary" loading="{{busy}}" disabled="{{busy || !selectedDevice || selectedDevice.presence !== 'online'}}" bindtap="play">在音箱播放</button>
      <view class="actions">
        <button class="secondary" disabled="{{busy}}" bindtap="addTrack">加入列表</button>
        <button class="secondary" bindtap="openQueue">播放列表 · {{queue.length}}</button>
      </view>
      <view class="actions">
        <button class="secondary" disabled="{{busy || !selectedDevice || selectedDevice.presence !== 'online'}}" bindtap="refreshStatus">查询状态</button>
      </view>
      <view class="status">{{statusText}}<text wx:if="{{volumeText}}"> · 音量 {{volumeText}}</text></view>
      <view class="hint">点击底部播放器，可暂停或继续播放。</view>
    </view>
    <view wx:if="{{tab === 'music'}}" class="card library-card">
      <view class="card-title">本机音乐库</view>
      <view class="hint">保存音频链接，在所选音箱播放；列表不会自动连续播放。</view>
      <input class="input search" value="{{search}}" data-field="search" bindinput="onInput" placeholder="搜索音频名称"/>
      <view class="library-tabs">
        <button class="filter {{libraryFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="filterLibrary">全部</button>
        <button class="filter {{libraryFilter === 'favorites' ? 'active' : ''}}" data-filter="favorites" bindtap="filterLibrary">收藏</button>
        <button class="filter {{libraryFilter === 'recent' ? 'active' : ''}}" data-filter="recent" bindtap="filterLibrary">最近播放</button>
      </view>
      <view wx:for="{{visibleTracks}}" wx:key="url" class="queue-row">
        <view class="queue-track" data-index="{{item.index}}" bindtap="selectTrack"><text class="queue-number">♫</text><view class="queue-track-copy"><view class="queue-title">{{item.title}}</view><view class="queue-url">{{item.url}}</view></view></view>
        <button class="icon-button {{item.favorite ? 'favorite-active' : ''}}" size="mini" data-index="{{item.index}}" bindtap="favoriteTrack" aria-label="{{item.favorite ? '取消收藏' : '收藏'}}">{{item.favorite ? '♥' : '♡'}}</button>
      </view>
      <view wx:if="{{!visibleTracks.length}}" class="empty-state">{{search ? '没有匹配的音频' : (libraryFilter === 'favorites' ? '点击音频旁的爱心，收藏喜欢的声音' : '播放音频后，会在这里留下记录')}}</view>
    </view>
    <view wx:if="{{tab === 'account'}}" class="card">
      <view class="card-title">小米账号已连接</view>
      <view class="hint">已发现 {{devices.length}} 台音箱。使用绑定设备的小米账号控制音箱。</view>
      <view class="settings-row"><text>当前音箱</text><text>{{selectedDevice ? selectedDevice.name : '未选择'}}</text></view>
      <view class="settings-row"><text>本机音频 / 收藏</text><text>{{queue.length}} / {{favorites.length}}</text></view>
      <view class="hint">音乐链接、收藏和最近播放仅保存在本机。退出登录会清除登录凭证，保留本机音乐库。</view>
      <button class="secondary" bindtap="copyDiagnostics">复制诊断信息</button>
      <button class="text-button" disabled="{{busy}}" bindtap="logout">退出登录</button>
    </view>
  </block>
  <view wx:if="{{message}}" class="notice" role="status">{{message}}</view>
  <view wx:if="{{error}}" class="notice error" role="alert">{{error}}</view>
  <button wx:if="{{error}}" class="text-button" bindtap="copyDiagnostics">复制诊断信息</button>

  <view wx:if="{{loggedIn && selectedDevice}}" class="mini-player" bindtap="openPlayer">
    <view class="mini-art"><view class="orbit"></view><text>♫</text></view>
    <view class="mini-copy"><view class="mini-title">{{currentTitle}}</view><view class="mini-subtitle">{{selectedDevice.name}} · {{statusText}}</view></view>
    <button size="mini" class="icon-button mini-toggle" catchtap="togglePlayback" aria-label="{{playbackState === 1 ? '暂停' : '播放'}}" disabled="{{busy || selectedDevice.presence !== 'online'}}"><view wx:if="{{playbackState === 1}}" class="pause-shape"></view><view wx:else class="play-shape"></view></button>
    <button size="mini" class="icon-button" catchtap="openQueue" aria-label="播放列表"><view class="list-shape"></view></button>
  </view>

  <view wx:if="{{loggedIn && playerOpen && selectedDevice}}" class="player-screen">
    <view class="player-top"><button size="mini" class="icon-button collapse" bindtap="closePlayer" aria-label="收起播放器">⌄</button><view class="player-top-copy"><view class="eyebrow">正在播放</view><view class="device-name">{{selectedDevice.name}}</view></view><button size="mini" class="icon-button" bindtap="refreshStatus" disabled="{{busy}}" aria-label="刷新状态">↻</button></view>
    <scroll-view scroll-y class="player-body"><view class="player-content">
      <view class="album-art"><view class="album-halo"></view><view class="album-orbit orbit-one"></view><view class="album-orbit orbit-two"></view><view class="album-star star-one"></view><view class="album-star star-two"></view><view class="album-caption">SOUND AT HOME</view><view class="album-name">{{currentTitle}}</view><view class="album-small">让声音，填满整个宇宙</view></view>
      <view class="track-heading"><view class="track-heading-copy"><view class="now-title">{{currentTitle}}</view><view class="now-artist">{{currentArtist}}</view></view><button size="mini" class="icon-button favorite-button {{isFavorite ? 'favorite-active' : ''}}" bindtap="toggleFavorite" disabled="{{!canFavorite}}" aria-label="{{isFavorite ? '取消收藏链接' : '收藏链接'}}">{{isFavorite ? '♥' : '♡'}}</button></view>
      <view class="playback-badge"><view class="state-dot {{isPlaying ? 'state-playing' : ''}}"></view><text>{{statusText}}</text></view>
      <view wx:if="{{unconfirmedPlaying}}" class="hint">音箱未返回播放内容，暂不能确认是否正在播放。点击播放会重新播放本机列表中选中的音频。</view>
      <button wx:if="{{unconfirmedPlaying}}" class="text-button" bindtap="pausePlayback" disabled="{{busy || selectedDevice.presence !== 'online'}}">发送暂停指令</button>
      <view class="playback-controls">
      <slider class="seek-slider" min="0" max="100" step="0.1" value="{{progress}}" activeColor="#fa2360" backgroundColor="#eceef2" block-size="16" bindchanging="onSeekChanging" bindchange="seek" disabled="{{busy || !duration || selectedDevice.presence !== 'online'}}" aria-label="播放进度"/>
      <view class="time-row"><text>{{positionText}}</text><text>{{durationText}}</text></view>
      <view wx:if="{{!duration}}" class="progress-note">音箱尚未返回音频时长</view>
      <view class="transport">
        <button size="mini" class="icon-button skip" data-step="-1" bindtap="changeTrack" disabled="{{busy || queue.length < 2 || selectedDevice.presence !== 'online'}}" aria-label="上一首"><view class="previous-shape"></view></button>
        <button size="mini" class="main-toggle" bindtap="togglePlayback" loading="{{busy}}" disabled="{{busy || selectedDevice.presence !== 'online'}}" aria-label="{{playbackState === 1 ? '暂停' : '播放'}}"><view wx:if="{{playbackState === 1}}" class="pause-shape"></view><view wx:else class="play-shape"></view><text class="toggle-label">{{playbackState === 1 ? '暂停' : '播放'}}</text></button>
        <button size="mini" class="icon-button skip" data-step="1" bindtap="changeTrack" disabled="{{busy || queue.length < 2 || selectedDevice.presence !== 'online'}}" aria-label="下一首"><view class="next-shape"></view></button>
      </view>
      </view>
      <view class="player-tools detail-tools">
        <button size="mini" class="tool-button" disabled="{{busy || selectedDevice.presence !== 'online'}}" bindtap="openVolume"><view class="tool-icon"><view class="speaker-shape"><view class="speaker-wave"></view></view></view><text>音量 {{volumeKnown ? volume + '%' : ''}}</text></button>
        <button size="mini" class="tool-button" disabled="{{busy || selectedDevice.presence !== 'online'}}" bindtap="changeLoop"><view class="tool-icon"><text class="tool-symbol">{{loopType === 3 ? '⤨' : '↻'}}</text></view><text>{{loopType === null ? '播放模式' : (loopType === 0 ? '单曲循环' : (loopType === 1 ? '列表循环' : (loopType === 2 ? '顺序播放' : '随机播放')))}}</text></button>
        <button size="mini" class="tool-button" bindtap="openQueue"><view class="tool-icon"><view class="list-shape"></view></view><text>列表 {{queue.length}}</text></button>
      </view>
      <button class="text-button" data-tool="timer" bindtap="openTool" disabled="{{busy || selectedDevice.presence !== 'online'}}">◷ 睡眠定时</button>
      <view wx:if="{{message}}" class="player-message">{{message}}</view><view wx:if="{{error}}" class="notice error">{{error}}</view><button wx:if="{{error}}" class="text-button" bindtap="copyDiagnostics">复制诊断信息</button>
    </view></scroll-view>
  </view>

  <view wx:if="{{loggedIn && queueOpen}}" class="sheet-mask" bindtap="closeQueue">
    <view class="queue-sheet" catchtap="noop">
      <view class="sheet-head"><view><view class="card-title">播放列表 <text class="queue-count">{{queue.length}}</text></view><view class="hint">本机保存 · 点击音频播放，左右按钮切歌</view></view><button size="mini" class="icon-button" bindtap="closeQueue" aria-label="关闭播放列表">×</button></view>
      <scroll-view scroll-y class="queue-scroll">
        <view wx:for="{{queue}}" wx:key="url" class="queue-row {{index === currentIndex ? 'queue-current' : ''}}">
          <view class="queue-track" data-index="{{index}}" bindtap="selectTrack"><text class="queue-number">{{index === currentIndex ? '♫' : index + 1}}</text><view class="queue-track-copy"><view class="queue-title">{{item.title}}</view><view class="queue-url">{{item.url}}</view></view><text wx:if="{{index === currentIndex}}" class="queue-playing">当前</text></view>
          <button size="mini" class="icon-button remove-track" data-index="{{index}}" bindtap="removeTrack" disabled="{{busy || index === currentIndex}}" aria-label="移除音频">×</button>
        </view>
      </scroll-view>
      <view class="queue-add"><view class="label">添加音频链接</view><textarea class="input audio-url" value="{{audioUrl}}" data-field="audioUrl" bindinput="onInput" maxlength="-1" disabled="{{busy}}" placeholder="粘贴 HTTP 或 HTTPS 音频链接"/><button class="primary" bindtap="addTrack" disabled="{{busy}}">加入播放列表</button></view>
      <view wx:if="{{message}}" class="player-message">{{message}}</view><view wx:if="{{error}}" class="notice error">{{error}}</view>
    </view>
  </view>

  <view wx:if="{{loggedIn && volumeOpen && selectedDevice}}" class="sheet-mask volume-mask" bindtap="closeVolume">
    <view class="volume-sheet" catchtap="noop">
      <view class="sheet-head"><view><view class="card-title">音箱音量</view><view class="hint">{{selectedDevice.name}}</view></view><button size="mini" class="icon-button" bindtap="closeVolume" aria-label="关闭音量调节">×</button></view>
      <view class="volume-readout">{{volumeKnown ? volume : '--'}}<text wx:if="{{volumeKnown}}">%</text></view>
      <view class="volume-row"><text class="volume-label">0</text><slider class="volume-slider" min="0" max="100" step="1" value="{{volume}}" activeColor="#fa2360" backgroundColor="#eceef2" block-color="#ffffff" block-size="26" bindchanging="onVolumeChanging" bindchange="changeVolume" disabled="{{busy || !volumeKnown || selectedDevice.presence !== 'online'}}" aria-label="音箱音量"/><text class="volume-label">100</text></view>
      <view class="volume-caption">{{volumeKnown ? '拖动滑杆，松开后调节音箱音量' : '正在读取音箱音量，请稍候'}}</view>
      <view wx:if="{{error}}" class="notice error">{{error}}</view>
      <button class="primary volume-done" bindtap="closeVolume">完成</button>
    </view>
  </view>
  <view wx:if="{{loggedIn}}" class="bottom-nav">
    <button class="nav-item {{tab === 'speaker' ? 'active' : ''}}" data-tab="speaker" bindtap="switchTab"><text>◉</text>音箱</button>
    <button class="nav-item {{tab === 'music' ? 'active' : ''}}" data-tab="music" bindtap="switchTab"><text>♫</text>音乐</button>
    <button class="nav-item {{tab === 'account' ? 'active' : ''}}" data-tab="account" bindtap="switchTab"><text>☺</text>我的</button>
  </view>
  <view wx:if="{{loggedIn && toolOpen && selectedDevice}}" class="sheet-mask tools-mask" bindtap="closeTool">
    <view class="tool-sheet" catchtap="noop">
      <view class="sheet-head"><view><view class="card-title">{{toolOpen === 'tts' ? '文字播报' : (toolOpen === 'timer' ? '睡眠定时' : (toolOpen === 'night' ? '夜间模式' : '设备信息'))}}</view><view class="hint">{{selectedDevice.name}}</view></view><button class="icon-button" size="mini" disabled="{{busy}}" bindtap="closeTool" aria-label="关闭">×</button></view>
      <block wx:if="{{toolOpen === 'tts'}}">
        <textarea class="input speech-input" value="{{ttsText}}" data-field="ttsText" bindinput="onInput" maxlength="500" placeholder="输入想让音箱说的话" disabled="{{busy}}"/>
        <view class="hint">{{ttsText.length}} / 500 字 · 播报可能中断当前音乐</view>
        <button class="primary" disabled="{{busy || !ttsText}}" loading="{{busy}}" bindtap="speak">在音箱播报</button>
      </block>
      <block wx:if="{{toolOpen === 'timer'}}">
        <view class="timer-status">{{timerText}}</view>
        <view class="hint">定时由音箱执行，关闭小程序后仍可生效。</view>
        <view class="timer-options"><button wx:for="{{[15,30,60,90,120]}}" wx:key="*this" class="secondary" data-minutes="{{item}}" bindtap="chooseTimer" disabled="{{busy}}">{{item}} 分钟</button></view>
        <button class="text-button" data-minutes="0" bindtap="chooseTimer" disabled="{{busy}}">取消定时</button>
      </block>
      <block wx:if="{{toolOpen === 'night'}}">
        <view class="hint">按时段降低音量、减弱灯光。不同机型支持情况以音箱返回为准。</view>
        <block wx:if="{{nightReady}}">
          <view class="settings-row"><text>定时夜间模式</text><switch checked="{{night.total === 'night'}}" data-field="total" bindchange="editNight" disabled="{{busy}}"/></view>
          <view class="settings-row"><text>减弱灯光</text><switch checked="{{night.light === 'night'}}" data-field="light" bindchange="editNight" disabled="{{busy}}"/></view>
          <view class="settings-row"><text>降低音量</text><switch checked="{{night.volume === 'night'}}" data-field="volume" bindchange="editNight" disabled="{{busy}}"/></view>
          <view class="settings-row"><text>开始时间</text><picker mode="time" value="{{night.start}}" data-field="start" bindchange="editNight" disabled="{{busy}}"><text class="time-picker">{{night.start}} ›</text></picker></view>
          <view class="settings-row"><text>结束时间</text><picker mode="time" value="{{night.stop}}" data-field="stop" bindchange="editNight" disabled="{{busy}}"><text class="time-picker">{{night.stop}} ›</text></picker></view>
          <button class="primary" bindtap="saveNight" disabled="{{busy}}" loading="{{busy}}">保存设置</button>
        </block>
        <view wx:elif="{{busy}}" class="empty-state">正在读取音箱设置…</view>
      </block>
      <block wx:if="{{toolOpen === 'info'}}">
        <view class="settings-row"><text>名称</text><text>{{selectedDevice.name}}</text></view>
        <view class="settings-row"><text>型号</text><text>{{selectedDevice.hardware}}</text></view>
        <view class="settings-row"><text>固件版本</text><text>{{selectedDevice.romVersion}}</text></view>
        <view class="settings-row"><text>连接状态</text><text>{{selectedDevice.presence === 'online' ? '在线' : '离线'}}</text></view>
        <view class="hint">新设备配网、绑定和固件更新请在小爱音箱官方 App 中完成。</view>
      </block>
      <view wx:if="{{message}}" class="player-message">{{message}}</view><view wx:if="{{error}}" class="notice error">{{error}}</view>
    </view>
  </view>
</view>
